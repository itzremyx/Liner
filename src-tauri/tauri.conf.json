{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liner",
  "version": "0.2.13",
  "identifier": "com.itzremyx.liner",
  "build": {
    "beforeDevCommand": "pnpm exec vite --mode tauri",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm exec tsc -b && pnpm exec vite build --mode tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Liner",
        "width": 1200,
        "height": 780,
        "minWidth": 1100,
        "minHeight": 705,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": ""
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/itzremyx/Liner/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
